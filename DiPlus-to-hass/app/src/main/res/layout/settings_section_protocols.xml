<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_telemetry_source"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_telemetry_source_summary"
        android:textColor="@color/textTertiary"
        android:textSize="12sp"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:id="@+id/radioTelemetrySource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioSourceDiplus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_source_diplus"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/radioSourceNative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_source_native"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/radioSourceAuto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_source_auto"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_debug_compare"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_debug_compare_summary"
                android:textColor="@color/textTertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <android.widget.Switch
            android:id="@+id/switchDebugCompare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_adb_host"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editAdbHost"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:hint="@string/settings_adb_host_hint"
            android:inputType="textUri"
            android:gravity="center"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_adb_port"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editAdbPort"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:hint="@string/settings_adb_port_hint"
            android:inputType="number"
            android:gravity="center"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_diplus_auth"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editDiplusAuth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:hint="@string/settings_diplus_auth_hint"
            android:inputType="text"
            android:gravity="center"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
