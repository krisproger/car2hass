<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_server"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/editHost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:hint="@string/settings_ha_server_address"
            android:inputType="textUri"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <CheckBox
            android:id="@+id/switchHttps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/settings_https"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:paddingStart="8dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editPort"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="8123"
        android:inputType="number"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <TextView
        android:id="@+id/tvHttpWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:text="@string/settings_http_warning"
        android:textColor="@color/accentYellow"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_token"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnTokenHelp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="@string/settings_token_help_title" />
    </LinearLayout>

    <EditText
        android:id="@+id/editToken"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="eyJhbGciOiJIUzI1NiIs..."
        android:inputType="textVisiblePassword"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editCarName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_car_name_hint"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_send_to_ha"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:text="@string/settings_test_connection"
        android:layout_marginTop="10dp" />
</LinearLayout>
