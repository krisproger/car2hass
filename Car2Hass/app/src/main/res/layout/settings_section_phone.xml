<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_phone_title"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_phone_hint"
        android:textColor="?attr/carTextSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_phone_toggle"
            android:textColor="?attr/carTextSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchPhoneSensors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <EditText
        android:id="@+id/editPhoneName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_phone_name_hint"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_phone_privacy"
        android:textColor="?attr/carTextSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/phoneSensorList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
