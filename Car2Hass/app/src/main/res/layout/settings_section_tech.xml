<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_system"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_boot_auto_start"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchBootAutoStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_car_control"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchCarControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_file_log_mode"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerFileLogMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_offline_queue"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchQueueEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_queue_max_mb"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editQueueMaxMb"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:gravity="center"
            android:inputType="number"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_queue_max_days"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editQueueMaxDays"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:gravity="center"
            android:inputType="number"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_background_mode"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchBackgroundMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnOpenAutoStart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:text="@string/settings_auto_start_byd" />

        <Button
            android:id="@+id/btnOpenRapidMode"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:text="@string/settings_background_work" />
    </LinearLayout>

    <Button
        android:id="@+id/btnApplyBackgroundMode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:text="@string/settings_apply_background_mode" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_service"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnLanguage"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:text="@string/settings_language"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnRefreshPresets"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:text="@string/settings_refresh_presets" />

        <TextView
            android:id="@+id/tvPresetVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnImportConfig"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:text="@string/settings_import_config" />

        <Button
            android:id="@+id/btnExportConfig"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@color/surfaceVariant"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:text="@string/settings_export_config" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRequestPermissions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:text="@string/settings_request_permissions" />

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:text="@string/update_check" />
</LinearLayout>
