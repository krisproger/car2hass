<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_cloud_title"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_cloud_hint"
        android:textColor="?attr/carTextSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_cloud_toggle"
            android:textColor="?attr/carTextSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchCloudSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <EditText
        android:id="@+id/editCloudEmail"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_cloud_email_hint"
        android:inputType="textEmailAddress"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <EditText
        android:id="@+id/editCloudCode"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_cloud_code_hint"
        android:inputType="number"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <EditText
        android:id="@+id/editCloudCarName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_cloud_car_name_hint"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <EditText
        android:id="@+id/editCloudBaseUrl"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_cloud_base_url_hint"
        android:inputType="textUri"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <Button
        android:id="@+id/btnCloudLogin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:text="@string/settings_cloud_login" />

    <TextView
        android:id="@+id/tvCloudStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="?attr/carTextSecondary"
        android:textSize="13sp" />
</LinearLayout>
