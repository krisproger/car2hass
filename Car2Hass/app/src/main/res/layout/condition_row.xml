<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="6dp">

    <Spinner
        android:id="@+id/condConnector"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:background="@color/surfaceVariant"
        android:gravity="center" />

    <CheckBox
        android:id="@+id/condNot"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/rules_condition_not"
        android:textSize="10sp" />

    <Spinner
        android:id="@+id/condSensor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/surfaceVariant" />

    <Spinner
        android:id="@+id/condOperator"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="@color/surfaceVariant"
        android:gravity="center" />

    <AutoCompleteTextView
        android:id="@+id/condValue"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:background="@color/surfaceVariant"
        android:textSize="12sp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:inputType="text" />

    <ImageButton android:id="@+id/condUp"
        android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/ic_arrow_up"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter" />
    <ImageButton android:id="@+id/condDown"
        android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/ic_arrow_down"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter" />
    <ImageButton android:id="@+id/condDelete"
        android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/ic_close"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter" />
</LinearLayout>
