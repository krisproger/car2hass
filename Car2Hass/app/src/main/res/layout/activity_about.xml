<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A1A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_version"
            android:textColor="#FFB0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_web"
                android:contentDescription="@string/about_site" />

            <TextView
                android:id="@+id/tvSite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_site"
                android:textColor="#FF4CAF50"
                android:textSize="14sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_telegram"
                android:contentDescription="@string/about_telegram" />

            <TextView
                android:id="@+id/tvTelegram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_telegram"
                android:textColor="#FF4CAF50"
                android:textSize="14sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_purpose_text"
            android:textColor="#FFB0B0B0"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_support"
            android:textColor="#FFFFC107"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAggregatorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donate_aggregator_title"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutAggregator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <include layout="@layout/donate_row_link" android:id="@+id/donateCloudtips" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBanksTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donate_banks_title"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#FF252525"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="#FFFFC107"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/layoutBanks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <include layout="@layout/donate_row" android:id="@+id/donateTbank" />
            <include layout="@layout/donate_row" android:id="@+id/donateAlfa" />
            <include layout="@layout/donate_row" android:id="@+id/donateSber" />
            <include layout="@layout/donate_row" android:id="@+id/donateVtb" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCryptoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donate_crypto_title"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#FF252525"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="#FFFFC107"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/layoutCrypto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <include layout="@layout/donate_row" android:id="@+id/donateUsdtTrc20" />
            <include layout="@layout/donate_row" android:id="@+id/donateBitcoin" />
            <include layout="@layout/donate_row" android:id="@+id/donateEthereum" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
