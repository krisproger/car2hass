<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/tileIconImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tileIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="24sp"
            android:textColor="?attr/carPrimary" />

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/carTextSecondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Semi-circle gauge arc -->
        <View
            android:id="@+id/tileGaugeArc"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_gauge_arc" />

        <View
            android:id="@+id/tileGaugeNeedle"
            android:layout_width="2dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@color/accentRed" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tileValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/carTextPrimary"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tileUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="14sp"
                android:textColor="?attr/carTextTertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tileSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="?attr/carTextTertiary"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tileZoneLeft"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="2dp"
        android:importantForAccessibility="no"
        android:alpha="0.6"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/tileZoneRight"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="2dp"
        android:importantForAccessibility="no"
        android:alpha="0.6"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tileDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:gravity="center"
        android:text="🗑️"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
