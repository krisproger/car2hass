<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_geofences"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnAddGeofence"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:text="@string/geofence_add"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/geofenceRowsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/geofenceEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/geofence_list_empty"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:padding="16dp"
        android:visibility="gone" />
</LinearLayout>