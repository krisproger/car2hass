<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_server"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvIntegrationUpdateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_integration_update_hint"
        android:textColor="@color/accentYellow"
        android:textSize="12sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvServersSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_servers_empty"
        android:textColor="?attr/carTextSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnConfigureServers"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:text="@string/settings_configure_servers"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editCarName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:hint="@string/settings_car_name_hint"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_send_to_ha"
            android:textColor="?attr/carTextSecondary"
            android:textSize="14sp" />

        <android.widget.Switch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvQueueBytes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/carTextSecondary"
        android:textSize="13sp"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/tvLastSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/carTextSecondary"
        android:textSize="13sp"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/tvLastAttempt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/carTextSecondary"
        android:textSize="13sp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:text="@string/settings_configure_servers"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnFlushQueue"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surfaceVariant"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:text="@string/settings_flush_now"
        android:layout_marginTop="6dp" />

</LinearLayout>
