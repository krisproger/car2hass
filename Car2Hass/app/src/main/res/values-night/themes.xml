<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Car2Hass" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primaryContainer</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <!-- Car2Hass palette (dark by default; per-car themes override these). -->
        <item name="carBackground">@color/background</item>
        <item name="carSurface">@color/surface</item>
        <item name="carSurfaceVariant">@color/surfaceVariant</item>
        <item name="carTextPrimary">@color/textPrimary</item>
        <item name="carTextSecondary">@color/textSecondary</item>
        <item name="carTextTertiary">@color/textTertiary</item>
        <item name="carPrimary">@color/primary</item>
        <item name="carPrimaryContainer">@color/primaryContainer</item>
        <item name="carOnPrimary">@color/onPrimary</item>
        <item name="carSecondary">@color/secondary</item>
        <item name="carAccentGreen">@color/accentGreen</item>
        <item name="carAccentRed">@color/accentRed</item>
        <item name="carAccentYellow">@color/accentYellow</item>
        <item name="carDivider">@color/divider</item>
        <item name="carCardBackground">@color/cardBackground</item>
        <item name="carTileBorder">@color/tileBorder</item>
        <item name="carTileBackground">@color/tileBackground</item>
    </style>

    <style name="TextAppearance.Car2Hass" parent="android:TextAppearance" />

    <!-- Dashboard tile value -->
    <style name="TextAppearance.Car2Hass.DashboardValue">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- Dashboard tile label -->
    <style name="TextAppearance.Car2Hass.DashboardLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <!-- Telemetry value (monospace) -->
    <style name="TextAppearance.Car2Hass.TelemetryValue">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:typeface">monospace</item>
    </style>

    <!-- Caption / small text -->
    <style name="TextAppearance.Car2Hass.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/textTertiary</item>
    </style>

    <!-- Section title inside cards -->
    <style name="TextAppearance.Car2Hass.SectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
</resources>